{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kleio-notion-discord",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["NOTION_API_TOKEN", "DISCORD_WEBHOOK_URL"]
  }
}
