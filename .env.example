# Public browser-safe Supabase configuration.
# Never place a service-role or Supabase secret key in this repository or a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_OR_PUBLISHABLE_KEY

# Optional browser-safe Mapbox public token for real-world typeahead.
# Restrict this token to KLEIO's GitHub Pages/preview origins and only the Search APIs used by KLEIO.
# The manual-entry fallback remains available when this variable is missing.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.YOUR_DOMAIN_RESTRICTED_PUBLIC_TOKEN
